        "auto_generated": false
      }
    },
    {
      "name": "libgcc/_umodsi3",
      "target_path": "payload/build/objdiff/libgcc/_umodsi3.o",
      "base_path": "payload/build/payload/asm/libgcc/_umodsi3.o",
      "metadata": {
        "complete": true,
        "source_path": "payload/asm/libgcc/_umodsi3.s",
