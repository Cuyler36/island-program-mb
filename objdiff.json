{
  "min_version": "3.7.1",
  "custom_make": "make",
  "build_base": true,
  "build_target": true,
  "watch_patterns": [
    "*.c",
    "*.h",
    "*.s",
    "*.inc",
    "*.py",
    "*.bin",
    "Makefile",
    "*.json"
  ],
  "ignore_patterns": [
    "payload/build/**/*"
  ],
  "units": [
    {
      "name": "payload/text",
      "target_path": "payload/build/objdiff/all.text.target.o",
      "base_path": "payload/build/objdiff/all.base.o",
      "scratch": {
        "platform": "gba",
        "compiler": "agbcc",
        "c_flags": "-O2 -g -mthumb-interwork -fhex-asm -Wimplicit -Werror",
        "ctx_path": "payload/build/payload/src/all.i",
        "build_ctx": false
      },
      "metadata": {
        "complete": false,
        "source_path": "payload/src/all.c",
        "auto_generated": false
      }
    },
    {
      "name": "payload/data",
      "target_path": "payload/build/objdiff/all.data.target.o",
      "base_path": "payload/build/objdiff/all.base.o",
      "metadata": {
        "complete": false,
        "source_path": "payload/src/all.c",
        "auto_generated": false
      }
    },
    {
      "name": "libgcc/_call_via_rX",
      "target_path": "payload/build/objdiff/libgcc/_call_via_rX.o",
      "base_path": "payload/build/payload/asm/libgcc/_call_via_rX.o",
      "metadata": {
        "complete": true,
        "source_path": "payload/asm/libgcc/_call_via_rX.s",
        "auto_generated": false
      }
    },
    {
      "name": "libgcc/_divsi3",
      "target_path": "payload/build/objdiff/libgcc/_divsi3.o",
      "base_path": "payload/build/payload/asm/libgcc/_divsi3.o",
