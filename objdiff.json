        "auto_generated": false
      }
    },
    {
      "name": "libgcc/_dvmd_tls",
      "target_path": "payload/build/objdiff/libgcc/_dvmd_tls.o",
      "base_path": "payload/build/payload/asm/libgcc/_dvmd_tls.o",
      "metadata": {
        "complete": true,
        "source_path": "payload/asm/libgcc/_dvmd_tls.s",
        "auto_generated": false
      }
    },
    {
      "name": "libgcc/_modsi3",
      "target_path": "payload/build/objdiff/libgcc/_modsi3.o",
      "base_path": "payload/build/payload/asm/libgcc/_modsi3.o",
